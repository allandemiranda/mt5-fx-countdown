# ==============================================================================
# MetaTrader 5 & MLOps Environment Configuration Template
# Copy this file to .env and customize the parameters for your local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MT5 Terminal & MetaEditor Executable Paths
# ------------------------------------------------------------------------------
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe           # Path to MT5 terminal executable
METAEDITOR_PATH=C:\Program Files\MetaTrader 5\metaeditor64.exe  # Path to MetaEditor compiler

# Optional: Explicit terminal data and common paths.
# If left blank, the Python orchestrator automatically discovers these via MetaTrader5 API.
MT5_DATA_PATH=C:\Users\<YOUR_USERNAME>\AppData\Roaming\MetaQuotes\Terminal\<YOUR_TERMINAL_ID_HASH>
MT5_COMMON_PATH=C:\Users\<YOUR_USERNAME>\AppData\Roaming\MetaQuotes\Terminal\Common

# ------------------------------------------------------------------------------
# 2. Strategy Tester Backtest & Watchdog Parameters
# ------------------------------------------------------------------------------
SYMBOL=EURUSD               # Trading asset pair symbol (e.g. EURUSD, GBPUSD, USDJPY)
TIMEFRAME=H1                # Chart timeframe period (M1, M5, M15, M30, H1, H4, D1)
MAGIC_NUMBER=222100         # Magic Number identifier for order tracking and position isolation
FROM_DATE=2012.01.01        # Historical backtest start date (YYYY.MM.DD)
TO_DATE=2026.01.31          # Historical backtest end date (YYYY.MM.DD)
SHUTDOWN_TERMINAL=1         # Auto-close terminal after test completion (1: Yes, 0: No)
BACKTEST_TIMEOUT=0          # Maximum backtest timeout in seconds (0: Infinite / manual control)
WATCHDOG_POLL_INTERVAL=10   # Watchdog polling check interval in seconds
SKIP_DATASET_GENERATION=0   # Skip MT5 Tester backtest and reuse existing CSVs if available (1: Yes, 0: No)
AVOID_PANDEMICTIME=0        # Skip pandemic / blackout period in DMatrix-EA (1: Yes, 0: No)
PANDEMIC_START_DATE=2020.01.01 00:00:00 # Blackout window start date/time in EET/EEST Server Time (inclusive)
PANDEMIC_END_DATE=2021.06.01 00:00:00   # Blackout window end date/time in EET/EEST Server Time (exclusive)

# ------------------------------------------------------------------------------
# 3. Feature Lookback, Triple Barrier Labeling & Live Risk Settings
# ------------------------------------------------------------------------------
FEATURE_LOOKBACK=4          # Past lookback lag count [t..t-N] for pattern recognition across all features

# Triple Barrier Momentum Labeling Settings (DMatrix-EA Data Collector)
LABEL_HORIZON_BARS=12       # Vertical barrier: Maximum holding bars before trade timeout (closes at market)
LABEL_MIN_POINTS=150        # Upper barrier: Minimum favorable points for positive momentum label (OPEN)
LABEL_MAX_ADVERSE_POINTS=150 # Lower barrier: Maximum adverse points for label invalidation (NOT_OPEN)

# ------------------------------------------------------------------------------
# 4. Daily Schedule & Session Trading Filters (MT5 Server Time)
# ------------------------------------------------------------------------------
# All schedule settings operate strictly in MT5 Server Time (chart clock: UTC+2 Winter / UTC+3 Summer EET/EEST).
# Major Forex market activity in MT5 Server Time:
# - Asian Session (Tokyo/Sydney):   00:00 - 09:00 MT5
# - London Session (Core Volume):   10:00 - 18:00 MT5
# - New York Session (Core Volume): 15:00 - 00:00 MT5
# - London + NY Overlap (Peak Vol): 15:00 - 18:00 MT5
#
# Daily Toggles (1: Enabled, 0: Disabled)
# Daily Hours Window (HH:MM:SS format, End Time is excluded).
# If End Time is 00:00:00, all 24 hours are permitted for that active day.
TRADE_MONDAY=1
TRADE_MONDAY_START=11:00:00
TRADE_MONDAY_END=18:00:00

TRADE_TUESDAY=1
TRADE_TUESDAY_START=10:00:00
TRADE_TUESDAY_END=18:00:00

TRADE_WEDNESDAY=1
TRADE_WEDNESDAY_START=10:00:00
TRADE_WEDNESDAY_END=18:00:00

TRADE_THURSDAY=1
TRADE_THURSDAY_START=10:00:00
TRADE_THURSDAY_END=18:00:00

TRADE_FRIDAY=1
TRADE_FRIDAY_START=10:00:00
TRADE_FRIDAY_END=16:00:00


# ------------------------------------------------------------------------------
# 4. XGBoost Machine Learning Hyperparameters
# ------------------------------------------------------------------------------
XGB_MAX_DEPTH=4             # Maximum tree depth for XGBoost
XGB_ETA=0.03                # Learning rate (shrinkage factor) for gradient boosting
XGB_SUBSAMPLE=0.8           # Subsample ratio of training instances per tree
XGB_COLSAMPLE_BYTREE=0.7    # Subsample ratio of columns when constructing each tree
XGB_MIN_CHILD_WEIGHT=5.0    # Minimum sum of instance weight (hessian) in a child node
XGB_LAMBDA=2.0              # L2 regularization term on leaf weights
XGB_ALPHA=0.5               # L1 regularization term on leaf weights
XGB_ROUNDS=300              # Number of boosting rounds (trees) to train
XGB_EARLY_STOPPING_ROUNDS=15 # Early stopping evaluation rounds on validation set
VALIDATION_PERCENTAGE=0.20  # Chronological time-series validation split ratio (e.g. 0.20 = last 20% validation)

# ------------------------------------------------------------------------------
# 5. Hyperparameter Optimization (Optuna Bayesian Search)
# ------------------------------------------------------------------------------
OPTUNA_TRIALS=20            # Number of hyperparameter search trials to evaluate

# ------------------------------------------------------------------------------
# 6. ML Directional Evaluation & Threshold Sensitivity Grid Parameters
# ------------------------------------------------------------------------------
EVAL_CLASSIFICATION_THRESHOLD=0.50 # Primary decision threshold for validation metrics (Accuracy, Precision, Recall, F1)
OPTUNA_OBJECTIVE_METRIC=logloss    # Metric optimized by Optuna: logloss, roc_auc, precision, f1
EVAL_ENABLE_THRESHOLD_GRID=1       # Enable parametric sensitivity grid report in terminal log (1: Enabled, 0: Disabled)
EVAL_THRESHOLD_MIN=0.40            # Minimum probability threshold evaluated in sensitivity grid
EVAL_THRESHOLD_MAX=0.70            # Maximum probability threshold evaluated in sensitivity grid
EVAL_THRESHOLD_STEP=0.02           # Step increment for parametric threshold sensitivity grid

# ------------------------------------------------------------------------------
# 7. Feature Toggles & Technical / Econometric Indicator Parameters
# ------------------------------------------------------------------------------
# Indicator & Econometric Feature Toggles (1: Enabled, 0: Disabled)
USE_ADX=1                   # Include Average Directional Index (Main, +DI, -DI)
USE_ATR=1                   # Include Average True Range (Normalized Volatility)
USE_BANDS=1                 # Include Bollinger Bands (Diff Mid, Bandwidth)
USE_MACD=1                  # Include MACD (Main, Signal)
USE_FAST_MA=1               # Include Fast Moving Average difference from price
USE_SLOW_MA=1               # Include Slow Moving Average difference from price
USE_RSI=1                   # Include Relative Strength Index (Momentum)
USE_STOCHASTIC=1            # Include Stochastic Oscillator (%K, %D)
USE_CANDLESTICK=1           # Include Candlestick microstructure (Type, Body size, Upper/Lower shadows)
USE_TIMESTAMP_WEEK=1        # Include Day of the Week encoded feature (0: Monday .. 4: Friday)
USE_TIMESTAMP_DAY=1         # Include Quarter of the Day encoded feature (0: 00-06h .. 3: 18-24h)
USE_OPEN_MARKETS=1          # Include Major Global Market Session active bitmask (Sydney, Tokyo, London, NY)
USE_SPREAD=1                # Include Current Spread in points
USE_GARCH_FEATURES=1        # Include GARCH(1,1) features (omega, alpha, beta, sigma, sigmaAgg) in dataset

# GARCH(1,1) Volatility Model Parameters
GARCH_HORIZON=8             # Forward forecast horizon in bars [t+1..t+H] for dynamic risk & feature extraction
PRICE_SIZE=500              # Historical sample size (bars) for GARCH volatility fitting
GARCH_ALPHA=0.05            # ARCH shock parameter (alpha > 0, weight of recent price shocks)
GARCH_BETA=0.92             # GARCH persistence parameter (beta > 0, alpha+beta < 1, volatility persistence)

# Indicator Periods, Shifts, Methods & Applied Prices
ADX_PERIOD=14               # Averaging period for ADX calculation
ATR_PERIOD=14               # Averaging period for ATR calculation
BANDS_PERIOD=20             # Calculation period for Bollinger Bands
BANDS_SHIFT=0               # Horizontal bar shift for Bollinger Bands
BANDS_DEV=2.0               # Standard deviation multiplier for Bollinger Bands
BANDS_APPLIED_PRICE=0       # Applied price for Bollinger Bands (0: Close, 1: Open, 2: High, 3: Low)
MACD_FAST=12                # Fast EMA period for MACD
MACD_SLOW=26                # Slow EMA period for MACD
MACD_SIGNAL=9               # Signal SMA period for MACD
MACD_APPLIED_PRICE=0        # Applied price for MACD (0: Close, 1: Open, 2: High, 3: Low)
FAST_MA_PERIOD=20           # Averaging period for Fast Moving Average
FAST_MA_SHIFT=0             # Horizontal bar shift for Fast Moving Average
FAST_MA_METHOD=1            # Smoothing method for Fast MA (0: SMA, 1: EMA, 2: SMMA, 3: LWMA)
FAST_MA_APPLIED_PRICE=0     # Applied price for Fast MA (0: Close, 1: Open, 2: High, 3: Low)
SLOW_MA_PERIOD=50           # Averaging period for Slow Moving Average
SLOW_MA_SHIFT=0             # Horizontal bar shift for Slow Moving Average
SLOW_MA_METHOD=1            # Smoothing method for Slow MA (0: SMA, 1: EMA, 2: SMMA, 3: LWMA)
SLOW_MA_APPLIED_PRICE=0     # Applied price for Slow MA (0: Close, 1: Open, 2: High, 3: Low)
RSI_PERIOD=14               # Averaging period for RSI calculation
RSI_APPLIED_PRICE=0         # Applied price for RSI (0: Close, 1: Open, 2: High, 3: Low)
STOCH_K=8                   # Period for Stochastic %K line
STOCH_D=3                   # Period for Stochastic %D line
STOCH_SLOWING=3             # Slowing factor for Stochastic
STOCH_METHOD=0              # Smoothing method for Stochastic (0: SMA, 1: EMA)
STOCH_PRICE_FIELD=0         # Price field for Stochastic (0: Low/High, 1: Close/Close)
